# ShipStation V1 API credentials (ShipStation → Settings → Account → API Settings)
SHIPSTATION_API_KEY=your_api_key_here
SHIPSTATION_API_SECRET=your_api_secret_here

# Postgres connection. On Railway this is provided automatically as DATABASE_URL
# when you add a Postgres database — you do NOT set it by hand there.
# For local testing only:
# DATABASE_URL=postgresql://postgres:pass@127.0.0.1:5432/shipscan
# PGSSL=disable

# How often to pull shipped orders from ShipStation (minutes)
SYNC_INTERVAL_MINUTES=25

# How many days back to keep pulling shipped orders
SYNC_LOOKBACK_DAYS=14

# Admin dashboard password (choose your own)
ADMIN_PASSWORD=changeme

# Port (Railway sets PORT automatically; leave blank in the cloud)
PORT=3000
